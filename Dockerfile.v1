FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY v1/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY v1/ ./

RUN mkdir -p /app/static/uploads

EXPOSE 5001

CMD ["sh", "-c", "python init_db.py && exec python app.py"]
