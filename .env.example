# Aplicacion
SECRET_KEY=cambiar-esta-clave-secreta-en-produccion-2026
DATABASE_URL=academico.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880

# Servidor (Gunicorn / dev)
PORT=5000
GUNICORN_WORKERS=3

# TLS/HTTPS directo (sin nginx): poner HTTPS=on para servir con certs de certs/
HTTPS=off
SSL_CERT=certs/cert.pem
SSL_KEY=certs/key.pem

# Despliegue (docker-compose) - V2 segura con Nginx TLS
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
DB_V2_FILE=db/v2_academico.db
